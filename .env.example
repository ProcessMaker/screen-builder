# Vibe IDE — AI Assistant
# Copy to .env and fill in one of the options below.

# ── Option A: OpenAI (or compatible API) ─────────────────────────────
VIBE_AI_PROVIDER=openai
VIBE_AI_API_KEY=sk-your-key-here
# VIBE_AI_MODEL=gpt-4o-mini
# VIBE_AI_BASE_URL=https://api.openai.com/v1

# ── Option B: Cursor sidecar (local agent) ───────────────────────────
# 1. npm install @cursor/sdk --save-dev
# 2. export CURSOR_API_KEY=your-cursor-api-key
# 3. npm run vibe:cursor-agent   (keep running in a terminal)
# 4. Uncomment:
# VIBE_AI_PROVIDER=cursor
# VIBE_CURSOR_AGENT_URL=http://127.0.0.1:4877
# VIBE_AI_MODEL=composer-2.5
